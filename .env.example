# ---------------------------------------------------------------------------
# HubMI — plik .env
#
# Skopiuj:  cp .env.example .env   (albo w Windows: copy .env.example .env)
# Potem wrzuć TU tylko rzeczy, których nie da się wygenerować z kodu:
# klucze API, hasła do wdrożenia, adresy. Reszta ma sensowne domyślne
# wartości i możesz jej nie ruszać.
#
# docker compose czyta .env sam — nie trzeba go nigdzie dopisywać.
# ---------------------------------------------------------------------------

# === AI — Jev, jedyny dostawca ==============================================
# W tym repo nie ma OpenAI, Anthropic ani Ollamy. Cała AI to Jev (TypeSafe),
# model decyzyjny, wołany przez Decisions API OpenRouter:
#     POST https://openrouter.ai/api/alpha/decisions
# Zwraca odpowiedzi typowane (noul / choice / score), nie tekst — dlatego
# werdykt „czy powiązane” dostajesz jako liczbę 0..1 plus pewność.
#
# Klucz: https://openrouter.ai/keys  (5 USD/mies. darmowych kredytów bywa
# w TypeSafe, tu liczy się token wejściowy ~0,042 USD/M)
JEV_API_KEY=
# Poniższe mają sensowne domyślne wartości — ruszaj tylko, gdy trzeba.
#JEV_URL=https://openrouter.ai/api/alpha/decisions
#JEV_MODEL=typesafe/jev-1.13
# próg: noul >= 0.5 → „powiązane”
#JEV_THRESHOLD=0.5
# ile sekund czekamy na odpowiedź (Jev odpowiada w 70–500 ms)
AI_TIMEOUT=30

# === HASŁA I HOSTING — wypełniasz TYLKO przy deployu ========================
# Przy demo lokalnym możesz nie ruszać.
DJANGO_SECRET_KEY=dev-only-zmien-przy-deployu
POSTGRES_PASSWORD=hubmi
DJANGO_ALLOWED_HOSTS=*
# Np. hubmi.example.pl  (po przecinku, bez http://)
# CORS_ALLOW_ORIGINS=

# === PORTY — domyślne OK ====================================================
BACKEND_PORT=8000
POSTGRES_PORT=5433

# === Co NIE jest w tym pliku ================================================
# - migracje i dane startowe: sam wchodzą przy starcie kontenera (import_data)
# - dane ROPS: data/ i app/src/data/ (montowane do kontenera, read-only)
# - klucz JEV_API_KEY: trzymany w .env, którego git nie widzi
