---
/**
 * Strona opisowa HubMI.
 *
 * Wygląda jak prototyp, bo jest zbudowana z jego tokenów i jego komponentów
 * (pasek dostępności, szklany nagłówek, hero z poświatą, karty). Różnica jest
 * w zadaniu: tu nie szuka się innowacji, tylko czyta, czym ten hub jest —
 * więc treść prowadzi, a kino zostaje w tle.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/backdrop.css";
import "../styles/landing.css";

const title = "HubMI — Małopolski Hub Innowacji Społecznych";
const description =
  "Opisz problem zwykłym językiem, a HubMI pokaże innowacje społeczne, które już ktoś przetestował w Małopolsce — z kontaktem do realizatora i rozliczeniem, dlaczego pasują.";

/** Adres prototypu. Przy wdrożeniu na własną domenę zmień tylko tę stałą. */
const APP_URL = "/app/";

/** Moduły z treści zadania — numeracja I–VII jest jej, nie nasza. */
const MODULES = [
  {
    no: "I",
    name: "Matchmaking społeczny",
    lead: true,
    text: "Rozmowa zamiast formularza. Opisujesz problem potocznie albo dyktujesz go głosem, asystent dopyta najwyżej dwa razy, a wynik to przetestowane innowacje z rozliczeniem „dlaczego to pasuje”: które wątki pokrywa, których nie, i jakie słowa to uruchomiły.",
  },
  {
    no: "II",
    name: "Zasobnik wiedzy",
    text: "115 innowacji (26 z filmem) i 76 dokumentów ROPS: raporty, diagnozy, Mapa Wyzwań Społecznych, wzory wniosków. Filtruje od pierwszej wpisanej litery.",
  },
  {
    no: "III",
    name: "Kreator pomysłów",
    text: "Fiszka na cztery pola, sprawdzenie, czy ktoś w regionie już tego nie zrobił, i szkic wniosku grantowego według realnego formularza ROPS.",
  },
  {
    no: "IV",
    name: "Tester innowacji",
    text: "Zgłoszenie gminy lub organizacji do testów i ocena 1–5 z wymaganym komentarzem — liczba bez uzasadnienia nie przechodzi.",
  },
  {
    no: "V",
    name: "Platforma komunikacji",
    text: "Wątki ROPS ↔ użytkownik ze wskaźnikiem nowej odpowiedzi. Sprawa ma jedno miejsce, nie łańcuch maili.",
  },
  {
    no: "VI",
    name: "Panel administratora",
    text: "Skrzynka zgłoszeń, odpowiedzi i zestawienie niezaspokojonych potrzeb — trendy powstają z samych zgłoszeń, bez dodatkowej ankiety.",
  },
  {
    no: "VII",
    name: "Middleman Innowacji",
    text: "Przerabia innowację na usługę konkretnej instytucji: koszt przy jej skali, obsada, kroki wdrożenia, ryzyka i wymogi formalne.",
  },
];

/** Wątki tematyczne rozpoznane w zdaniu z mostka — nazwy z lib/concepts.ts. */
const THREADS = ["samotność i izolacja", "osoby starsze", "obszary wiejskie"];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/sf-pro-display" />

    <!--
      Preferencje dostępności są wspólne z prototypem (ten sam klucz
      localStorage), więc senior, który raz powiększył czcionkę, nie ustawia
      jej drugi raz po przejściu do aplikacji. Skrypt musi być tutaj i
      synchronicznie — inaczej strona mignęłaby w złym motywie.
    -->
    <script is:inline>
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem("hubmi.a11y.v1") || "{}");
          var r = document.documentElement;
          if (p.theme === "light" || p.theme === "dark") r.setAttribute("data-theme", p.theme);
          if (p.highContrast) r.setAttribute("data-contrast", "high");
          if (p.fontScale) r.style.setProperty("--fs-scale", String(p.fontScale));
        } catch (e) {
          /* tryb prywatny albo uszkodzony wpis — zostają ustawienia domyślne */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>

    <!-- Warstwa dekoracyjna. Nic tu nie niesie informacji. -->
    <div class="backdrop no-print" id="backdrop" aria-hidden="true">
      <div class="backdrop__grid"></div>
      <div class="backdrop__glow backdrop__glow--a"><span class="backdrop__drift"></span></div>
      <div class="backdrop__glow backdrop__glow--b"><span class="backdrop__drift"></span></div>
      <div class="backdrop__spot"></div>
    </div>

    <div class="a11ybar no-print">
      <div class="wrap a11ybar__inner">
        <p class="a11ybar__label" id="a11y-label">Dostosuj widok</p>
        <div class="row" role="group" aria-labelledby="a11y-label">
          <div class="row a11ybar__group" role="group" aria-label="Rozmiar tekstu">
            <button type="button" class="btn btn--icon btn--ghost" data-scale="1">
              <span aria-hidden="true">A</span>
              <span class="sr-only">Czcionka normalna, 18 pikseli</span>
            </button>
            <button type="button" class="btn btn--icon btn--ghost" data-scale="1.25">
              <span aria-hidden="true">A+</span>
              <span class="sr-only">Czcionka duża, 22 piksele</span>
            </button>
            <button type="button" class="btn btn--icon btn--ghost" data-scale="1.5">
              <span aria-hidden="true">A++</span>
              <span class="sr-only">Czcionka bardzo duża, 27 pikseli</span>
            </button>
          </div>
          <button type="button" class="btn btn--ghost" id="toggle-contrast">Wysoki kontrast</button>
          <button type="button" class="btn btn--ghost" id="toggle-theme">Jasny motyw</button>
          <!-- WCAG 2.2.2: ruch trwający dłużej niż 5 s musi mieć widoczną pauzę. -->
          <button type="button" class="btn btn--ghost" id="toggle-motion">Ruch w tle</button>
        </div>
      </div>
    </div>

    <header class="hdr">
      <div class="wrap hdr__inner">
        <a class="hdr__brand" href="/">
          <span class="hdr__mark" aria-hidden="true"></span>
          <span>
            <strong>HubMI</strong>
            <span class="hdr__sub">Małopolski Hub Innowacji Społecznych</span>
          </span>
        </a>

        <nav class="hdr__nav" aria-label="Sekcje strony">
          <ul>
            <li><a href="#czym-jest">Czym jest</a></li>
            <li><a href="#dopasowanie">Dopasowanie</a></li>
            <li><a href="#moduly">Moduły</a></li>
            <li><a href="#dostepnosc">Dostępność</a></li>
            <li><a href="#koszt">Koszt</a></li>
          </ul>
        </nav>

        <a class="btn btn--primary hdr__cta" href={APP_URL}>Otwórz prototyp</a>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero" id="hero">
        <div class="hero__glow" aria-hidden="true"></div>
        <div class="hero__content wrap">
          <p class="hero__eyebrow">
            HackYeah 2026 · zadanie Województwa Małopolskiego · realizator ROPS Kraków
          </p>
          <h1>
            Opisz problem.&#32;<span class="hero__accent">Pokażemy, co już zadziałało.</span>
          </h1>
          <p class="hero__lede">
            HubMI dopasowuje innowacje społeczne przetestowane w Małopolsce do problemu
            opisanego zwykłym językiem — i za każdym razem pokazuje, dlaczego akurat te.
          </p>
          <div class="row hero__actions">
            <a class="btn btn--primary" href={APP_URL}>Otwórz prototyp</a>
            <a class="btn" href="#dopasowanie">Zobacz, jak działa dopasowanie</a>
          </div>
        </div>
      </section>

      <section class="sect" id="czym-jest" aria-labelledby="czym-jest-h">
        <div class="wrap">
          <div class="sect__head" data-reveal>
            <p class="eyebrow">Czym to jest</p>
            <h2 id="czym-jest-h">Baza przetestowanych rozwiązań, do której wchodzi się od problemu</h2>
            <p>
              ROPS Kraków prowadzi Bibliotekę Innowacji Społecznych: 115 rozwiązań
              sprawdzonych w regionie — przedmiotów, usług cyfrowych i metod pracy.
              Żeby cokolwiek w niej znaleźć, trzeba jednak znać nazwę i kategorię.
              HubMI odwraca kierunek: wchodzi opis własnymi słowami, wychodzi
              rozwiązanie z kontaktem do realizatora. A kiedy nic nie pasuje,
              zgłoszenie nie znika — staje się pozycją w zestawieniu niezaspokojonych
              potrzeb dla ROPS.
            </p>
          </div>

          <ul class="figures" data-reveal="stagger">
            <li class="card figure figure--lead">
              <span class="figure__num mono">111 / 115</span>
              <span class="figure__label">
                kart innowacji ma opisany <strong>wynik realnego testu</strong>. To jedyna
                rzecz, której nie ma żaden inny katalog pomysłów — i na niej stoi
                obietnica całego produktu.
              </span>
              <div class="figure__meter" aria-hidden="true"><span></span></div>
            </li>
            <li class="card figure">
              <span class="figure__num mono">115</span>
              <span class="figure__label">innowacji z Biblioteki ROPS, w tym 26 z nagraniem</span>
            </li>
            <li class="card figure">
              <span class="figure__num mono">76</span>
              <span class="figure__label">dokumentów ROPS: raporty, diagnozy, wzory wniosków</span>
            </li>
            <li class="card figure">
              <span class="figure__num mono">0</span>
              <span class="figure__label">naruszeń axe-core na ośmiu widokach prototypu</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="sect" id="dopasowanie" aria-labelledby="dopasowanie-h">
        <div class="wrap">
          <div class="sect__head" data-reveal>
            <p class="eyebrow">Moduł I — obowiązkowy</p>
            <h2 id="dopasowanie-h">Mostek pojęciowy: z języka ludzi na język Biblioteki</h2>
            <p>
              Mieszkanka nie powie „izolacja społeczna osób starszych na obszarach
              wiejskich”. Powie to tak, jak sąsiadowi. Dopasowanie zaczyna się od
              przetłumaczenia jednego na drugie.
            </p>
          </div>

          <div class="card" data-reveal>
            <div class="bridge">
              <div class="bridge__side">
                <p class="eyebrow">Co wpisuje mieszkanka</p>
                <p class="bridge__quote">
                  „Mama <mark>mieszka sama</mark> na <mark>wsi</mark> i
                  <mark>nie ma z kim pogadać</mark>”
                </p>
              </div>

              <div class="bridge__arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 10h13M11 5l5 5-5 5" />
                </svg>
              </div>

              <div class="bridge__side">
                <p class="eyebrow">Co rozpoznaje silnik</p>
                <ul class="bridge__threads">
                  {THREADS.map((t) => <li class="chip chip--accent">{t}</li>)}
                </ul>
              </div>
            </div>

            <p class="bridge__foot">
              Bez tego mostka zapytanie nie trafia w nic: w kartach ROPS ten problem
              nazywa się osamotnieniem i izolacją społeczną. Silnik to BM25 po siedmiu
              polach karty plus 22 wątki tematyczne — liczy się w przeglądarce, bez
              wywołania API, więc demo działa też w gminie ze słabym łączem i nie ma
              kosztu zmiennego.
            </p>

            <p class="formula">
              <span>Wynik dopasowania =</span>
              <b>65% ważonego pokrycia wątków</b>
              <span>+</span>
              <b>35% siły leksykalnej</b>
              <span>· karta bez opisanego wyniku testu dostaje mnożnik 0,88, a powód
              jest wypisany w uzasadnieniu</span>
            </p>
          </div>

          <ul class="points" data-reveal="stagger" style="margin-top: var(--sp-5)">
            <li class="card point">
              <h3>Widać, dlaczego pasuje</h3>
              <p>
                Każde trafienie pokazuje, które wątki pokrywa, których nie pokrywa,
                w którym polu karty się zgadza i jakie słowa to uruchomiły —
                podświetlone w tekście. Trafności nie trzeba brać na wiarę.
              </p>
            </li>
            <li class="card point">
              <h3>Brak dopasowania to dane, nie błąd</h3>
              <p>
                Gdy nic nie pasuje, zgłoszenie trafia do zestawienia niezaspokojonych
                potrzeb, a nierozpoznane słowa tworzą listę pojęć, których Bibliotece
                brakuje. Moduł analityczny powstaje sam, z ruchu użytkowników.
              </p>
            </li>
            <li class="card point">
              <h3>Mapa na prawdziwej geometrii</h3>
              <p>
                22 jednostki — 19 powiatów i 3 miasta na prawach powiatu — wycięte
                z danych GUS. Klikalne, osiągalne tabulatorem, z odpowiednikiem
                tabelarycznym. Obok przycisk kontaktu do realizatora.
              </p>
            </li>
            <li class="card point">
              <h3>Pętla zamyka się na żywo</h3>
              <p>
                Zgłoś pomysł, przełącz rolę na pracownika ROPS, odpowiedz w panelu
                i wróć jako autorka, żeby zobaczyć odpowiedź. Cała ścieżka działa
                w prototypie.
              </p>
            </li>
          </ul>
        </div>
      </section>

      <section class="sect" id="moduly" aria-labelledby="moduly-h">
        <div class="wrap">
          <div class="sect__head" data-reveal>
            <p class="eyebrow">Zakres</p>
            <h2 id="moduly-h">Siedem modułów z zadania — wszystkie działają</h2>
            <p>
              Numeracja jest z treści zadania. Matchmaking był obowiązkowy; pozostałe
              sześć modułów domyka drogę od zgłoszenia problemu do wdrożenia usługi.
            </p>
          </div>

          <ul class="mods" data-reveal="stagger">
            {MODULES.map((m) => (
              <li class:list={["card", "mod", m.lead && "mod--lead"]}>
                <div class="mod__top">
                  <span class="mod__no" aria-hidden="true">{m.no}</span>
                  <h3>
                    <span class="sr-only">Moduł {m.no}: </span>{m.name}
                  </h3>
                  {m.lead && <span class="chip chip--ok">moduł obowiązkowy</span>}
                </div>
                <p>{m.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="sect" id="dostepnosc" aria-labelledby="dostepnosc-h">
        <div class="wrap">
          <div class="sect__head" data-reveal>
            <p class="eyebrow">Dostępność</p>
            <h2 id="dostepnosc-h">Projektowane dla seniorki, nie dla zrzutu ekranu</h2>
            <p>
              Grupa docelowa zadania to m.in. osoby starsze i osoby
              z niepełnosprawnościami. Dostępność jest więc warunkiem działania
              produktu, a nie listą kontrolną domykaną na końcu.
            </p>
          </div>

          <div class="a11y-grid">
            <div class="card" data-reveal="left">
              <ul class="a11y-list">
                <li>
                  <span aria-hidden="true">✓</span>
                  <span><b>0 naruszeń axe-core</b> na ośmiu widokach, powtarzalne jedną komendą</span>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <span><b>Baza 18 px</b>, nie 16 — przełącznik podnosi do 27 px</span>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <span><b>Paleta policzona skryptem</b>: najsłabsza para tekstowa 4,75:1, tryb wysokiego kontrastu 21:1</span>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <span><b>Kolor nigdy nie jest jedynym nośnikiem</b> — dochodzi słowo, znak albo kreskowanie</span>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <span><b>Mapa i wykresy mają odpowiedniki tabelaryczne</b>, powiaty są osiągalne tabulatorem</span>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <span><b>Mikrofon jest dodatkiem, nie jedyną drogą</b> — obok zawsze stoi pole tekstowe</span>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <span><b>Brak przewijania w poziomie</b> przy 390, 768 i 1280 px</span>
                </li>
              </ul>
            </div>

            <div class="card card--flat" data-reveal="right">
              <h3>Uczciwie o liczbach</h3>
              <p class="muted" style="font-size: var(--fs-sm)">
                axe-core wyłapuje około jednej trzeciej problemów z dostępnością.
                „Zero naruszeń” znaczy „bez błędów wykrywalnych automatycznie”,
                nie „dostępne”. Czy seniorka zrozumie treść i czy kolejność focusu
                ma sens — tego nie sprawdzi żaden skrypt. Test z użytkownikami jest
                pierwszą rzeczą do zrobienia po hackathonie.
              </p>
              <p class="muted" style="font-size: var(--fs-sm); margin-top: var(--sp-4)">
                Przełączniki w pasku na górze tej strony to te same przełączniki co
                w prototypie i zapisują się w tym samym miejscu — ustawienie przechodzi
                razem z użytkownikiem.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="sect" id="koszt" aria-labelledby="koszt-h">
        <div class="wrap">
          <div class="sect__head" data-reveal>
            <p class="eyebrow">Utrzymanie</p>
            <h2 id="koszt-h">Ile to kosztuje rocznie</h2>
            <p>
              Dwa warianty: prototyp w obecnej postaci i wdrożenie produkcyjne dla
              całego województwa. Największą pozycją są ludzie, jak w każdym systemie
              publicznym.
            </p>
          </div>

          <div class="cost" data-reveal="stagger">
            <div class="card">
              <p class="eyebrow">Wariant A — prototyp statyczny</p>
              <h3>Bez backendu, dane w plikach</h3>
              <div class="scroll-x" style="margin-top: var(--sp-4)">
                <table>
                  <caption class="sr-only">Koszty roczne wariantu A</caption>
                  <tbody>
                    <tr><th scope="row">Hosting statyczny (CDN, plan darmowy)</th><td class="num">0 zł</td></tr>
                    <tr><th scope="row">Domena .pl i certyfikat SSL</th><td class="num">~80 zł</td></tr>
                    <tr><th scope="row">Odświeżanie danych z ROPS, kwartalnie</th><td class="num">~400 zł</td></tr>
                  </tbody>
                </table>
              </div>
              <p class="cost__sum">
                <b class="mono">~500 zł</b>
                <span>rocznie · obsługuje dowolną liczbę czytelników, nie obsługuje zgłoszeń</span>
              </p>
            </div>

            <div class="card">
              <p class="eyebrow">Wariant B — wdrożenie produkcyjne</p>
              <h3>Zgłoszenia, wątki i panel działają naprawdę</h3>
              <div class="scroll-x" style="margin-top: var(--sp-4)">
                <table>
                  <caption class="sr-only">Koszty roczne wariantu B</caption>
                  <tbody>
                    <tr><th scope="row">Infrastruktura: hosting, PostgreSQL, pliki, monitoring, poczta</th><td class="num">~6 100 zł</td></tr>
                    <tr><th scope="row">Koordynator treści w ROPS (0,25 etatu)</th><td class="num">~30 000 zł</td></tr>
                    <tr><th scope="row">Utrzymanie techniczne (~8 h/mies.) i audyt dostępności</th><td class="num">~27 000 zł</td></tr>
                  </tbody>
                </table>
              </div>
              <p class="cost__sum">
                <b class="mono">~63 000 zł</b>
                <span>rocznie · wdrożenie jednorazowo 80–120 tys. zł, czyli jeden grant z naboru ROPS</span>
              </p>
            </div>
          </div>

          <p class="muted" style="margin-top: var(--sp-5); font-size: var(--fs-sm)">
            Dlaczego tak tanio: silnik dopasowania działa w przeglądarce, więc za AI nie
            ma kosztu zmiennego; cały stos jest otwarty; statyczny front skaluje się
            przez CDN, więc szczyt przy naborze grantowym nie wymaga dokładania mocy.
          </p>
        </div>
      </section>

      <section class="sect closer" aria-labelledby="closer-h">
        <div class="wrap" data-reveal>
          <h2 id="closer-h">Najkrócej: opisz problem, zobacz, co już zadziałało</h2>
          <p class="muted">
            Prototyp jest kompletny — siedem modułów, prawdziwe dane ROPS, pełna obsługa
            klawiaturą. Wejdź i spróbuj zdania, które ktoś mógłby powiedzieć w kolejce
            w urzędzie.
          </p>
          <div class="row">
            <a class="btn btn--primary" href={APP_URL}>Otwórz prototyp</a>
            <a class="btn" href="#czym-jest">Wróć na początek</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="ftr">
      <div class="wrap stack">
        <p class="mono">
          Prototyp na HackYeah 2026 · zadanie Województwa Małopolskiego, realizator ROPS Kraków
        </p>
        <p>
          Dane innowacji pochodzą z Biblioteki Innowacji Społecznych ROPS (115 kart,
          w większości CC BY 4.0). Lokalizacje wdrożeń, kontakty realizatorów
          i zgłoszenia w panelu są danymi demonstracyjnymi — prototyp nie używa
          prawdziwych danych osobowych.
        </p>
      </div>
    </footer>

    <script>
      /**
       * Trzy rzeczy: przełączniki dostępności (wspólne z prototypem),
       * pojawianie się treści przy przewijaniu i parallax tła.
       * Wszystkie trzy schodzą z drogi, gdy użytkownik nie chce ruchu.
       */
      const KEY = "hubmi.a11y.v1";
      const root = document.documentElement;

      type Prefs = {
        theme?: "auto" | "light" | "dark";
        fontScale?: number;
        highContrast?: boolean;
        simpleLanguage?: boolean;
        bgMotion?: boolean;
      };

      function read(): Prefs {
        try {
          return JSON.parse(localStorage.getItem(KEY) || "{}") as Prefs;
        } catch {
          return {};
        }
      }

      // Zapis zachowuje pola, których ta strona nie ustawia (np. prosty język) —
      // preferencje są wspólne z aplikacją, więc nie wolno ich tu zgubić.
      function write(patch: Prefs) {
        const next = { ...read(), ...patch };
        try {
          localStorage.setItem(KEY, JSON.stringify(next));
        } catch {
          /* tryb prywatny — ustawienia działają do zamknięcia karty */
        }
        return next;
      }

      const prefs = read();
      let theme = prefs.theme === "light" ? "light" : "dark";
      let contrast = Boolean(prefs.highContrast);
      let scale = prefs.fontScale || 1;
      let motion = prefs.bgMotion !== false;

      const scaleBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-scale]")];
      const contrastBtn = document.getElementById("toggle-contrast") as HTMLButtonElement;
      const themeBtn = document.getElementById("toggle-theme") as HTMLButtonElement;
      const motionBtn = document.getElementById("toggle-motion") as HTMLButtonElement;
      const backdrop = document.getElementById("backdrop") as HTMLElement;
      const hero = document.getElementById("hero") as HTMLElement;

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      function apply() {
        root.setAttribute("data-theme", theme);
        if (contrast) root.setAttribute("data-contrast", "high");
        else root.removeAttribute("data-contrast");
        root.style.setProperty("--fs-scale", String(scale));

        scaleBtns.forEach((b) =>
          b.setAttribute("aria-pressed", String(Number(b.dataset.scale) === scale)),
        );
        contrastBtn.setAttribute("aria-pressed", String(contrast));
        motionBtn.setAttribute("aria-pressed", String(motion));
        themeBtn.textContent = theme === "dark" ? "Jasny motyw" : "Ciemny motyw";

        // Tło żyje tylko wtedy, gdy wolno: zgoda systemowa, zgoda użytkownika
        // i brak trybu wysokiego kontrastu (tam rozjaśnienia psują kontrast).
        const live = motion && !reduced.matches && !contrast;
        backdrop.classList.toggle("backdrop--live", live);
        return live;
      }

      let live = apply();

      scaleBtns.forEach((b) =>
        b.addEventListener("click", () => {
          scale = Number(b.dataset.scale);
          write({ fontScale: scale });
          live = apply();
        }),
      );
      contrastBtn.addEventListener("click", () => {
        contrast = !contrast;
        write({ highContrast: contrast });
        live = apply();
      });
      themeBtn.addEventListener("click", () => {
        theme = theme === "dark" ? "light" : "dark";
        write({ theme });
        live = apply();
      });
      motionBtn.addEventListener("click", () => {
        motion = !motion;
        write({ bgMotion: motion });
        live = apply();
      });
      reduced.addEventListener("change", () => {
        live = apply();
      });

      /* --- pojawianie się treści --- */
      /* Klasa na <html> dopiero teraz: bez JS treść jest widoczna od razu,
         nigdy odwrotnie. */
      if (!reduced.matches) {
        root.classList.add("js-reveal");
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add("reveal--in");
              io.unobserve(e.target);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
      }

      /* --- sygnatura: poświata hero gaśnie, gdy treść przejmuje ekran --- */
      const heroWatch = new IntersectionObserver(
        ([e]) => hero.classList.toggle("hero--past", !e.isIntersecting),
        { threshold: 0.35 },
      );
      heroWatch.observe(hero);

      /* --- parallax tła: jedna współrzędna na klatkę --- */
      let tx = 0,
        ty = 0,
        x = 0,
        y = 0,
        raf = 0;

      function tick() {
        // Lerp co klatkę daje opóźnienie warstw — to ono robi wrażenie głębi.
        x += (tx - x) * 0.06;
        y += (ty - y) * 0.06;
        backdrop.style.setProperty("--bx", x.toFixed(4));
        backdrop.style.setProperty("--by", y.toFixed(4));
        backdrop.style.setProperty("--px", ((x + 1) / 2).toFixed(4));
        backdrop.style.setProperty("--py", ((y + 1) / 2).toFixed(4));
        raf = requestAnimationFrame(tick);
      }

      window.addEventListener(
        "pointermove",
        (e) => {
          if (!live) return;
          tx = (e.clientX / window.innerWidth) * 2 - 1;
          ty = (e.clientY / window.innerHeight) * 2 - 1;
          if (!raf) raf = requestAnimationFrame(tick);
        },
        { passive: true },
      );

      let sraf = 0;
      function onScroll() {
        if (sraf) return;
        sraf = requestAnimationFrame(() => {
          sraf = 0;
          if (!live) {
            backdrop.style.setProperty("--sy", "0");
            return;
          }
          const vh = window.innerHeight || 1;
          // ±3 ekrany: bez limitu tło zjechałoby poza kadr na długiej stronie.
          const sy = Math.max(-3, Math.min(3, window.scrollY / vh));
          backdrop.style.setProperty("--sy", sy.toFixed(3));
        });
      }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
